# Copy to .env for local experiments, or paste these into Vercel's environment
# variables. Never commit real keys: .gitignore excludes .env and .env.* (except
# this example file).
#
# The public site needs NONE of these. They exist only for /api (the dashboard
# and the published-content feeds).

# --- required for a real deployment -------------------------------------------
# Supabase project URL and its secret service_role key (Settings -> API).
# The service_role key is server-side ONLY: it is never sent to a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- first run only: lets /admin/ show the "create the first account" form ----
# Set to 1, create the account, then delete this variable again.
# CMS_ALLOW_SETUP=1

# --- optional (defaults are already sensible) ---------------------------------
# CMS_DRIVER=supabase                 # "local" = dev-only JSON/file store
# CMS_STORAGE_BUCKET=media
# CMS_IMAGE_TRANSFORM=1               # Supabase-rendered WebP thumbnails
# CMS_THUMB_WIDTH=800
# CMS_THUMB_HEIGHT=600
# CMS_THUMB_QUALITY=72
# CMS_MAX_IMAGE_BYTES=8388608         # 8 MB per photo
# CMS_MAX_DOCUMENT_BYTES=5242880      # 5 MB per PDF
# CMS_MAX_IMAGES_PER_UPLOAD=6
# CMS_SESSION_HOURS=12
# CMS_LOGIN_MAX_FAILS=8
# CMS_LOGIN_WINDOW_MINUTES=15
# CMS_PUBLIC_CACHE_SECONDS=60
# CMS_LOCAL_DIR=.cms-data             # local driver only
